{
  "name": "authentication-system-server",
  "version": "2.1.0",
  "main": "src/core/index.ts",
  "scripts": {
    "dev": "tsx watch src/core/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "swagger:ui": "swagger-ui-express -p 3001 -f swagger.json",
    "swagger:json": "tsx ./src/config/swagger/printSpec.ts > swagger.json",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:functional": "vitest run --project functional",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:functional && pnpm test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build:watch": "tsup --watch",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:clean": "docker compose down -v",
    "docker:test": "pnpm docker:up && pnpm test:e2e"
  },
  "keywords": [],
  "author": "Juan David Cardona Bageth",
  "license": "ISC",
  "type": "module",
  "description": "Sistema de authentication para react con nodejs",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20 <26"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "22.12.0",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "3.1.9",
    "prettier": "^3.5.3",
    "supertest": "^7.3.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "resend": "^4.1.2",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.67"
  }
}
