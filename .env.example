# Puerto del servidor HTTP y de WebSocket
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# Secretos de tokens. Generar con: openssl rand -hex 32
TOKEN_SECRET_KEY=
REFESCH_TOKEN_SECRET_KEY=

# Base de datos MongoDB
DATABASE_URL=mongodb://localhost:27017/authentication-system

# Servicio de email (Resend)
RESEND_KEY=

# Autenticacion con Google
CLIENT_GOOGLE_ID=
CLIENT_GOOGLE_SECRET=

# Origenes permitidos en WebSocket, separados por coma.
# No usar '*' con credenciales: es una contradiccion de CORS y rompe en Docker.
SOCKET_CORS_ORIGIN=http://localhost:3000

# Limite de solicitudes global
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Cache de verificacion de contrasena (Redis).
# Es una aceleracion, no una dependencia: si Redis cae, el login sigue
# hasheando normalmente. Poner false lo apaga por completo.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
# Ventana en la que una contrasena ya verificada no se vuelve a hashear.
# Es una ventana de riesgo para la revocacion: mientras vive, un cambio de
# contrasena no se refleja en el camino cacheado.
PASSWORD_CACHE_TTL_SECONDS=30
